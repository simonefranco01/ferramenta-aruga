---
// Modello di pagina servizio, ricavato dal design "Serrature e cilindri".
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import Steps from '../components/Steps.astro';
import Review from '../components/Review.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { faqJsonLd } from '../lib/schema';
import { url } from '../lib/url';

export type WhyBox =
  | { kind: 'years'; value: number; label: string }
  | { kind: 'title'; text: string }
  | { kind: 'text'; text: string };

interface Props {
  title: string;
  description: string;
  service: string;
  tag: string;
  h1: string;
  lead: string;
  photoLabel: string;
  heroCta?: { href: string; label: string; track: string; external?: boolean };
  situations?: { q: string; a: string }[];
  whatWeDo: string[];
  why: WhyBox[];
  review?: { quote: string; author: string };
  faqs?: FaqItem[];
}

const p = Astro.props;
const heroCta = p.heroCta ?? { href: '#preventivo', label: 'Chiedi il preventivo gratuito', track: 'preventivo' };
---
<Base title={p.title} description={p.description} ctaHref="#preventivo" jsonLd={p.faqs ? [faqJsonLd(p.faqs)] : []}>
  <section class="section bg-yellow">
    <div class="hero-service">
      <a href={url('/#servizi')} class="back-link"><Icon name="arrow-left" size={18} />Tutti i servizi</a>
      <div class="hero-service__grid">
        <div class="hero-service__text">
          <span class="tag">{p.tag}</span>
          <h1 class="h1-service" data-rv="up">{p.h1}</h1>
          <p class="lead" data-rv="up" data-d="120">{p.lead}</p>
          <a
            href={heroCta.href}
            class="btn btn-blue btn-lg"
            data-rv="up"
            data-d="220"
            data-track={heroCta.track}
            data-track-where="hero"
            {...(heroCta.external ? { target: '_blank', rel: 'noopener' } : {})}
          >{heroCta.label} <Icon name="arrow" size={20} /></a>
          <slot name="hero-extra" />
        </div>
        <PhotoPlaceholder label={p.photoLabel} ratio="54" rv delay={150} />
      </div>
    </div>
  </section>

  {p.situations && (
    <section class="section bg-cream">
      <div class="container pad-y">
        <h2 class="h2-sm" style="margin-bottom:32px;max-width:18ch">Ti riconosci in una di queste situazioni?</h2>
        <div class="situations">
          {p.situations.map((s, i) => (
            <div class="situation" data-rv="pop" data-d={i * 70}>
              <p class="situation__q">“{s.q}”</p>
              <p class="situation__a"><span aria-hidden="true">→</span>{s.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <slot name="before-what" />

  <section class="section bg-white">
    <div class="container pad-y" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:clamp(32px,5vw,64px)">
      <div>
        <h2 class="h2-sm" style="margin-bottom:24px">Cosa facciamo</h2>
        <ul class="checklist">
          {p.whatWeDo.map((item) => (
            <li><span class="check" aria-hidden="true"><Icon name="check" size={16} stroke="#141414" /></span>{item}</li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="h2-sm" style="margin-bottom:24px">Perché noi</h2>
        <div class="why-grid">
          {p.why.map((w, i) => (
            <div class:list={['why', { 'why--yellow': w.kind === 'years', 'why--blue': w.kind === 'text' }]}data-rv="pop" data-d={i * 80}>
              {w.kind === 'years' && (
                <>
                  <div class="why__num"><span data-rv="count" data-to={w.value}>{w.value}</span></div>
                  <div class="why__label">{w.label}</div>
                </>
              )}
              {w.kind === 'title' && <div class="why__title">{w.text}</div>}
              {w.kind === 'text' && <div class="why__text">{w.text}</div>}
            </div>
          ))}
        </div>
        {p.review && (
          <div class="mt-28">
            <Review quote={p.review.quote} author={p.review.author} variant="feature" rv="up" />
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section bg-blue on-dark">
    <div class="container" style="padding-block:clamp(48px,6vw,80px)">
      <h2 class="h2-sm" style="margin-bottom:32px">Come funziona</h2>
      <Steps />
    </div>
  </section>

  <slot name="after-steps" />

  {p.faqs && <Faq items={p.faqs} />}

  <QuoteForm service={p.service} />
</Base>
