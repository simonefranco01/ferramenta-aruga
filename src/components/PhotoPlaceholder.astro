---
// Foto con cornice del design. Senza `src` mostra il riquadro segnaposto "FOTO: …"
// (elenco nel README); con `src` mostra la foto vera.
import { Image } from 'astro:assets';

interface Props {
  label: string;
  ratio?: '43' | '54' | '45';
  rv?: boolean;
  delay?: number;
  src?: ImageMetadata;
  alt?: string;
  position?: string;
}
const { label, ratio = '43', rv = false, delay = 0, src, alt = '', position = 'center' } = Astro.props;
---
<div
  class:list={['photo', `photo--${ratio}`, { 'photo--img': !!src }]}
  data-rv={rv ? 'pop' : undefined}
  data-d={rv ? delay : undefined}
>
  {src ? (
    <Image src={src} alt={alt} width={900} class="photo__img" style={`object-position:${position}`} widths={[480, 720, 900]} sizes="(max-width: 760px) 92vw, 560px" />
  ) : (
    <span class="ph-label" aria-hidden="true">FOTO: {label}</span>
  )}
  <slot />
</div>
