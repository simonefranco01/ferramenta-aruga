---
// Icone SVG inline a tratto spesso, come nel design.
interface Props {
  name: 'phone' | 'arrow' | 'arrow-left' | 'key' | 'roller' | 'window' | 'bulb' | 'check' | 'camera' | 'whatsapp' | 'pin' | 'mail';
  size?: number;
  stroke?: string;
  class?: string;
}
const { name, size = 24, stroke = 'currentColor', class: cls } = Astro.props;
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={stroke}
  stroke-width={name === 'check' ? 3.2 : name.startsWith('arrow') ? 2.6 : 2.4}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'phone' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M19 12H5M11 6l-6 6 6 6" />}
  {name === 'key' && <><circle cx="8" cy="12" r="4" /><path d="M12 12h9M18 12v3M21 12v2" /></>}
  {name === 'roller' && <><rect x="3" y="3" width="14" height="6" rx="1" /><path d="M17 6h3v5h-8v3" /><rect x="10.5" y="14" width="3" height="7" rx="1" /></>}
  {name === 'window' && <><rect x="4" y="3" width="16" height="18" rx="1" /><path d="M4 8h16M4 13h16M9 3v18M15 3v18" /></>}
  {name === 'bulb' && <path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0 0 12 3z" />}
  {name === 'check' && <path d="M5 12l5 5 9-10" />}
  {name === 'camera' && <><path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></>}
  {name === 'whatsapp' && <><path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z" /><path d="M9 8.5c0 3.5 2.8 6.5 6.5 6.5l1-1.6-2-1-1 .9a5 5 0 0 1-2.8-2.8l.9-1-1-2z" /></>}
  {name === 'pin' && <><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></>}
</svg>
