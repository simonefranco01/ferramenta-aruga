  description="Zanzariere su misura, binari per balcone, bastoni e tende da esterno a Torino. Prendiamo le misure noi e ci affidiamo ai nostri artigiani per il montaggio. Preventivo gratuito."
  service="zanzariere-tende"
  tag="Zanzariere, binari balcone e sistemi per tende"
  h1="Zanzariere e tende fatte per le tue finestre."
  lead="Prendiamo le misure noi e ci affidiamo ai nostri artigiani per il montaggio. Preventivo gratuito."
  photoLabel="zanzariera montata su una finestra"
  whatWeDo={[
    'Zanzariere su misura',
    'Tende da esterno',
    'Binari per balcone',
    'Bastoni per tende',
    'Misure prese da noi',
    'Montaggio con i nostri artigiani di fiducia',
  ]}
  why={[
    { kind: 'years', value: 2026 - site.foundingYear, label: 'anni nel quartiere' },
    { kind: 'title', text: 'Negozio di famiglia, tre generazioni' },
    { kind: 'title', text: 'Aperti anche il sabato' },
