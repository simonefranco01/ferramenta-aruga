---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Steps from '../components/Steps.astro';
import Review from '../components/Review.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import WhereWeAre from '../components/WhereWeAre.astro';
import Icon from '../components/Icon.astro';
import badge40 from '../assets/logo-40-anni.png';
import { services } from '../data/services';
import { site, founder, ratingDisplay } from '../lib/site';
import { url } from '../lib/url';

const years = 2026 - site.foundingYear;
const Founder = founder.charAt(0).toUpperCase() + founder.slice(1);
---
<Base
  title="Ferramenta e colorificio a Torino Santa Rita dal 1986 | Ferramenta Aruga"
  description="Ferramenta e colorificio San Marco in Via Barletta 55/B, Torino Santa Rita. Serrature e cilindri, colori su misura, zanzariere e tende. Preventivo gratuito, nessun costo di uscita."
  ctaHref="#servizi"
>
  <section class="section bg-yellow">
    <div class="hero-home">
      <h1 class="h1-home" data-rv="up">Arrivi con un problema, esci con la soluzione.</h1>
      <p class="lead" data-rv="up" data-d="120">Ferramenta e colorificio a Santa Rita dal 1986. Serrature, colori su misura, zanzariere e tende: il lavoro lo facciamo noi.</p>
      <ul class="chips" data-rv="up" data-d="220">
        <li class="chip">★ {ratingDisplay} su Google · {site.rating.count} recensioni</li>
        <li class="chip">Aperti anche il sabato</li>
        <li class="chip">Nessun costo di uscita</li>
      </ul>

      <h2 id="servizi" class="services-title">Di cosa hai bisogno?</h2>
      <div class="service-grid">
        {services.map((s, i) => <ServiceCard service={s} delay={i * 90} />)}
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container pro-band">
      <div class="pro-band__text">
        <span class="eyebrow">Per professionisti e strutture</span>
        <p>Decoratori, manutentori e strutture: vernici San Marco da rivenditore ufficiale e un negozio aperto anche il sabato.</p>
      </div>
      <a href={url('/professionisti/')} class="btn btn-white">Parliamone <Icon name="arrow" size={18} /></a>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container pad-y">
      <h2 class="h2" style="margin-bottom:36px">Come funziona</h2>
      <Steps />
      <a href="#servizi" class="btn btn-blue btn-lg" style="margin-top:36px;min-height:56px" data-track="preventivo" data-track-where="come-funziona">Chiedi il preventivo gratuito</a>
    </div>
  </section>

  <section class="section bg-blue on-dark">
    <div class="container pad-y">
      <div class="reviews-head">
        <h2 class="h2">Cosa dicono i clienti</h2>
        <div class="rating-badge">
          <span class="rating-badge__value"><span data-rv="count" data-to={site.rating.value} data-dec="1">{ratingDisplay}</span></span>
          <span class="rating-badge__meta">
            <span class="stars" role="img" aria-label="Valutazione media su Google">★★★★★</span>
            <span><span data-rv="count" data-to={site.rating.count}>{site.rating.count}</span> recensioni Google</span>
          </span>
        </div>
      </div>
      <div class="review-grid">
        <Review quote="Se si arriva con un problema la soluzione si trova! Grazie di cuore" author="Davide B." />
        <Review quote="È più di una ferramenta, è più di un colorificio." author="Paolo R." variant="yellow" delay={80} />
        <Review quote="La mia ferramenta di fiducia nel cuore del quartiere Santa Rita. A gestione familiare il personale è accogliente, gentile, disponibile, molto professionale e competente." author="Franca S." variant="long" delay={160} />
        <Review quote="Hanno una grande pazienza anche con chi è alle prime armi!" author="Anedda MC" />
        <Review quote="Gentilissimi, hanno una soluzione per tutto e prezzi onestissimi!" author="Ludovica D." delay={80} />
        <Review quote="Seri e competenti, ti aiutano a trovare soluzioni con cooperazione e disponibilità di altri tempi." author="Pier Paolo C." delay={160} />
      </div>
    </div>
  </section>

  <section class="section bg-yellow">
    <div class="container pad-y two-col">
      <div class="story">
        <h2 class="h2">La nostra storia: <span data-rv="count" data-to={years}>{years}</span> anni a Santa Rita</h2>
        <p>Nel 1986 {founder} apre il negozio in Via Barletta. Poi arriva Giorgio, oggi c'è Vittorio: tre generazioni che hanno fatto crescere l'attività mantenendo al centro la qualità, la disponibilità e la cura del cliente. Oggi siamo ferramenta, colorificio con servizio tintometrico San Marco, chiavi e serrature, casalinghi, materiale elettrico e idraulico.</p>
        <div class="timeline-wrap">
        <span class="timeline__track" aria-hidden="true"></span>
        <span class="timeline__fill" aria-hidden="true" data-rv="fill" data-dur="2600"></span>
        <ol class="timeline">
          {[
            { y: '1986', t: `${Founder} apre in Via Barletta`, d: 200 },
            { y: 'Poi', t: 'Arriva Giorgio', d: 900 },
            { y: 'Oggi', t: "C'è Vittorio", d: 1600 },
            { y: '2026', t: `${years} anni`, d: 2300, last: true },
          ].map((s) => (
            <li>
              <svg class="timeline__screw" data-rv="screw" data-d={s.d} width="28" height="28" viewBox="0 0 22 22" aria-hidden="true">
                <circle cx="11" cy="11" r="9.5" fill={s.last ? '#274695' : '#fff'} stroke="#141414" stroke-width="2" />
                <path d="M6 11h10M11 6v10" stroke={s.last ? '#F6C801' : '#141414'} stroke-width="2.2" stroke-linecap="round" />
              </svg>
              <strong>{s.y}</strong>
              <span>{s.t}</span>
            </li>
          ))}
        </ol>
        </div>
      </div>
      <PhotoPlaceholder label="quattro generazioni">
        <Image src={badge40} alt="Logo 40 anni di attività, Ferramenta Aruga" width={380} height={380} class="badge-40" data-rv="pop" data-d="200" />
      </PhotoPlaceholder>
    </div>
  </section>

  <WhereWeAre />
</Base>
