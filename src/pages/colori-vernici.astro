---
import ServicePage from '../layouts/ServicePage.astro';
import { site } from '../lib/site';
import tintometro from '../assets/tintometro.webp';
---
<ServicePage
  title="Colorificio San Marco a Torino, colori e vernici personalizzati | Ferramenta Aruga"
  description="Colori e vernici personalizzati al tintometro a Torino Santa Rita. Rivenditori ufficiali San Marco e consigli sul prodotto giusto. Preventivo gratuito."
  service="colori-vernici"
  tag="Colori e vernici personalizzati"
  h1="Il colore che hai in mente, preparato al momento."
  lead="Il colore che vuoi, preparato al momento grazie al nostro tintometro. Siamo rivenditori ufficiali San Marco e ti consigliamo il prodotto giusto."
  photoLabel="tintometro e barattoli di vernice"
  photo={tintometro}
  photoAlt="Il tintometro San Marco del negozio e gli scaffali con i barattoli di vernice"
  photoPosition="50% 60%"
  whatWeDo={[
    'Colore preparato al momento con il nostro tintometro',
    'Consigli sul prodotto giusto per il tuo lavoro',
    'Vernici San Marco, rivenditori ufficiali',
    'Preventivo gratuito',
  ]}
  why={[
    { kind: 'years', value: 2026 - site.foundingYear, label: 'anni nel quartiere' },
    { kind: 'title', text: 'Rivenditori ufficiali San Marco' },
    { kind: 'title', text: 'Negozio di famiglia, tre generazioni' },
    { kind: 'text', text: 'Ti aiutiamo a scegliere il prodotto giusto, direttamente in negozio.' },
  ]}
  review={{
    quote: "Da sempre un punto di riferimento in Santa Rita per il fai da te o per una spesa importante come il cambio serratura o tinteggiare l'abitazione.",
    author: 'Concetta D.',
  }}
  faqs={[
    { q: 'Siete rivenditori ufficiali San Marco?', a: 'Sì, siamo rivenditori ufficiali San Marco, con servizio tintometrico in negozio.' },
    { q: 'Mi aiutate a scegliere il prodotto?', a: 'Sì, in negozio ti consigliamo il prodotto giusto per il lavoro che devi fare.' },
    { q: 'Quanto costa?', a: 'Dipende dal prodotto e dalla quantità. Chiedi un preventivo gratuito.' },
  ]}
/>
